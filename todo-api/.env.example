# Database (Supabase connection string)
DATABASE_URL=

# Brevo (ส่งอีเมล OTP)
BREVO_API_KEY=
BREVO_USER=

# JWT - ต้องตั้งค่า ไม่งั้น API จะไม่ start (สร้างด้วย: openssl rand -hex 32)
JWT_SECRET=

# false = โหมด log-only (เตือนใน log แต่ยังไม่บล็อก request ที่ไม่มี token) ใช้ช่วงทยอย deploy
AUTH_ENFORCE=true

# Firebase project สำหรับตรวจ ID token ของ social login
FIREBASE_PROJECT_ID=tamraidee

PORT=3000
